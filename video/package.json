{
  "name": "poppyseed-video",
  "private": true,
  "type": "module",
  "description": "The Poppyseed demo video, made with Remotion from a recorded run of the live demo.",
  "exports": {
    ".": "./src/index.ts",
    "./steps": "./src/steps.ts"
  },
  "scripts": {
    "studio": "remotion studio src/root.tsx",
    "render": "remotion render src/root.tsx DemoVideo ../site/public/demo.mp4",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/fonts": "4.0.534",
    "@remotion/transitions": "4.0.534",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.534",
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
